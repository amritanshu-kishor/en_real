# AI ENGLISH REALITY Server Environment Configuration Example
PORT=5000
NODE_ENV=development

# Google Gemini API Key
# Enter your Gemini API key here rather than entering on the website.
# The server will automatically detect and load it for scenario generation, 
# dynamic debates, speech coaching, and deep evaluation.
# Get your API key from: https://aistudio.google.com/app/apikey
